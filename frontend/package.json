{
  "name": "modular-template-frontend",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "contracts:generate": "openapi-typescript ../backend/docs/contracts/openapi.json -o libs/api-client/src/generated/api.ts",
    "contracts:check": "npm run contracts:generate && git diff --exit-code -- libs/api-client/src/generated/api.ts",
    "architecture:structure": "node tools/check-structure.mjs",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx}\" \"libs/api-client/src/client/*.ts\" \"tools/*.mjs\""
  },
  "private": true,
  "devDependencies": {
    "@eslint/js": "^9.8.0",
    "@next/eslint-plugin-next": "^16.1.6",
    "@nx/eslint": "^24.0.6",
    "@nx/eslint-plugin": "24.0.6",
    "@nx/js": "^24.0.6",
    "@nx/next": "^24.0.6",
    "@nx/react": "^24.0.6",
    "@nx/vite": "^24.0.6",
    "@nx/vitest": "^24.0.6",
    "@nx/web": "24.0.6",
    "@swc-node/register": "1.12.1",
    "@swc/cli": "~0.8.1",
    "@swc/core": "1.16.22",
    "@swc/helpers": "0.5.24",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "@vitest/coverage-v8": "~5.1.1",
    "@vitest/ui": "~5.1.1",
    "eslint": "^9.8.0",
    "eslint-config-next": "^16.1.6",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "5.0.0",
    "jiti": "2.7.0",
    "jsdom": "^27.1.0",
    "nx": "^24.0.6",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.8.1",
    "tslib": "^2.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.0.0",
    "vitest": "~5.1.1"
  },
  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "packageManager": "npm@11.21.2",
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^9.5.0",
    "@tanstack/react-query": "^5.108.1",
    "next": "~16.4.1",
    "openapi-fetch": "^0.17.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "6.30.3"
  },
  "allowScripts": {
    "nx@24.0.6": true,
    "@swc/core@1.15.8": true
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
}
